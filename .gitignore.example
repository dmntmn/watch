# ============================================================
#  Watch — .gitignore
#  Переименуйте этот файл в .gitignore (рядом с ним).
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------- Виртуальное окружение ----------
venv/
.venv/
env/
ENV/

# ---------- Переменные окружения ----------
# Реальные секреты — только в .env; шаблон .env.example коммитим.
.env
.env.*
!.env.example

# ---------- Тесты / покрытие ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# ---------- Линтеры / тайп-чекеры ----------
.mypy_cache/
.pytype/
.pyre/
.ruff_cache/
.dmypy.json
dmypy.json

# ---------- Логи и временные артефакты ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Frontend (Vite / TypeScript) ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
*.tsbuildinfo

# ---------- IDE / редакторы ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- ОС ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Дампы БД ----------
*.sql.gz
*.dump