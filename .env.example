# ============================================================
#  Watch — сервис учёта занятости работников
#  Скопируйте в .env и заполните значения
# ============================================================

# --- Application ---
APP_NAME=Watch
DEBUG=false
# JSON-список разрешённых origin (для браузерного клиента)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://watch:watch@localhost:5432/watch

# --- Redis (pub/sub шина событий для live-обновлений) ---
REDIS_URL=redis://localhost:6379/0
EVENTS_CHANNEL=watch:data-changed

# --- Keycloak ---
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=watch
KEYCLOAK_CLIENT_ID=watch-backend
KEYCLOAK_CLIENT_SECRET=
# Переопределения (по умолчанию выводятся из server_url/realm):
# KEYCLOAK_JWKS_URL=
# KEYCLOAK_ISSUER=
# KEYCLOAK_AUDIENCE=

# --- SMTP (уведомления работникам по email) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@watch.local
SMTP_TLS=false
SMTP_STARTTLS=false

# --- S3 (файлы-подтверждения; MinIO локально) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=watch-attachments
S3_REGION=us-east-1
S3_USE_SSL=false